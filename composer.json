{
	"name": "derintolu/learning-ledger",
	"description": "An xAPI LRS and Open Badges issuer for WordPress, with LMS connectors",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"paragonie/sodium_compat": "^2.1",
		"accredifysg/php-json-ld": "^2.2",
		"accredifysg/php-rdf-canonicalize": "^1.0",
		"opis/json-schema": "^2.4",
		"league/commonmark": "^2.6",
		"firebase/php-jwt": "^7.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0",
		"wp-phpunit/wp-phpunit": "^7.1",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "*",
		"dealerdirect/phpcodesniffer-composer-installer": "*",
		"brianhenryie/strauss": "*"
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.2.0"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"extra": {
		"strauss": {
			"target_directory": "vendor-prefixed",
			"namespace_prefix": "LearningLedger\\Vendor\\",
			"classmap_prefix": "LearningLedger_Vendor_",
			"packages": [
				"paragonie/sodium_compat",
				"accredifysg/php-json-ld",
				"accredifysg/php-rdf-canonicalize",
				"opis/json-schema",
				"league/commonmark",
				"firebase/php-jwt"
			],
			"update_call_sites": false,
			"delete_vendor_packages": false,
			"delete_vendor_files": false
		}
	},
	"scripts": {
		"test:unit": "phpunit -c phpunit-unit.xml.dist",
		"test:integration": "npx wp-env run tests-cli --env-cwd=wp-content/plugins/learning-ledger vendor/bin/phpunit -c phpunit.xml.dist",
		"test:http": "phpunit -c phpunit-http.xml.dist",
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"prefix": "strauss",
		"conformance:lrs": "bin/conformance-lrs.sh",
		"conformance:catapult": "bin/catapult-lts.sh"
	}
}
