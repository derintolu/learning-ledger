<?xml version="1.0"?>
<phpunit bootstrap="tests/bootstrap-http.php" colors="true" convertErrorsToExceptions="true" convertWarningsToExceptions="true" convertNoticesToExceptions="true" convertDeprecationsToExceptions="true">
	<testsuites>
		<testsuite name="http">
			<directory prefix="test-" suffix=".php">tests/http</directory>
		</testsuite>
	</testsuites>
</phpunit>
