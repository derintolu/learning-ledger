<?xml version="1.0"?>
<phpunit bootstrap="tests/bootstrap-unit.php" colors="true" convertErrorsToExceptions="true" convertWarningsToExceptions="true" convertNoticesToExceptions="true" convertDeprecationsToExceptions="true">
	<testsuites>
		<testsuite name="unit">
			<directory prefix="test-" suffix=".php">tests/unit</directory>
		</testsuite>
	</testsuites>
</phpunit>
